                >
                  <option value="">Select institution</option>
                  {suggestedInstitutions.map(institution => (
                    <option key={institution.id} value={institution.id}>
                      {institution.name}
                    </option>
                  ))}
                </select>
              </div>
              
              <div>
                <label className="block text-sm font-medium text-gray-700 mb-2">
                  Seat of Arbitration
                </label>
                <select
                  name="seatOfArbitration"
                  value={formData.seatOfArbitration}
                  onChange={handleInputChange}
                  className="w-full p-3 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500"
                  required
                >
                  <option value="">Select seat</option>
                  <option value="London">London</option>
                  <option value="Singapore">Singapore</option>
                  <option value="Paris">Paris</option>
                  <option value="Geneva">Geneva</option>
                  <option value="New York">New York</option>
                  <option value="Hong Kong">Hong Kong</option>
                  {/* Additional seats would be added here */}
                </select>
              </div>
            </div>

            <div className="grid grid-cols-1 md:grid-cols-3 gap-6 mt-6">
              <div>
                <label className="block text-sm font-medium text-gray-700 mb-2">
                  Governing Law
                </label>
                <select
                  name="governingLaw"
                  value={formData.governingLaw}
                  onChange={handleInputChange}
                  className="w-full p-3 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500"
                  required
                >
                  <option value="">Select law</option>
                  <option value="English">English Law</option>
                  <option value="New York">New York Law</option>
                  <option value="Singapore">Singapore Law</option>
                  <option value="Swiss">Swiss Law</option>
                  <option value="French">French Law</option>
                  {/* Additional laws would be added here */}
                </select>
              </div>
              
              <div>
                <label className="block text-sm font-medium text-gray-700 mb-2">
                  Language
                </label>
                <select
                  name="language"
                  value={formData.language}
                  onChange={handleInputChange}
                  className="w-full p-3 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500"
                  required
                >
                  <option value="English">English</option>
                  <option value="French">French</option>
                  <option value="German">German</option>
                  <option value="Spanish">Spanish</option>
                  <option value="Chinese">Chinese</option>
                  {/* Additional languages would be added here */}
                </select>
              </div>
              
              <div>
                <label className="block text-sm font-medium text-gray-700 mb-2">
                  Number of Arbitrators
                </label>
                <select
                  name="arbitratorCount"
                  value={formData.arbitratorCount}
                  onChange={handleInputChange}
                  className="w-full p-3 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500"
                  required
                >
                  <option value="1">1 (Sole arbitrator)</option>
                  <option value="3">3 (Tribunal)</option>
                </select>
              </div>
            </div>
          </div>
        );
        
      case 4:
        return (
          <div className="space-y-6">
            <h2 className="text-2xl font-bold">Generated Clauses</h2>
            
            {loading ? (
              <div className="flex justify-center items-center h-64">
                <div className="animate-spin rounded-full h-12 w-12 border-b-2 border-blue-700"></div>
              </div>
            ) : (
