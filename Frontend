// ClauseBuilder.jsx
import React, { useState, useEffect } from 'react';
import { useNavigate } from 'react-router-dom';
import { 
  Download, Copy, Save, Info, AlertCircle, ArrowRight, ArrowLeft, Check 
} from 'lucide-react';
import { Tooltip } from '@/components/ui/tooltip';

const ClauseBuilder = () => {
  const navigate = useNavigate();
  const [currentStep, setCurrentStep] = useState(1);
  const [formData, setFormData] = useState({
    clauseType: 'arbitration',
    partyANationality: '',
    partyBNationality: '',
    subjectMatterLocation: '',
    enforcementLocations: '',
    seatOfArbitration: '',
    governingLaw: '',
    language: 'English',
    arbitratorCount: '3',
    institution: ''
  });
  
  const [suggestedInstitutions, setSuggestedInstitutions] = useState([]);
  const [generatedClauses, setGeneratedClauses] = useState([]);
  const [loading, setLoading] = useState(false);
  const [showTooltip, setShowTooltip] = useState(false);
  
  // Step information
  const steps = [
    { id: 1, name: 'Clause Type' },
    { id: 2, name: 'Party Information' },
    { id: 3, name: 'Dispute Details' },
    { id: 4, name: 'Results' }
  ];

  useEffect(() => {
    // Only fetch institution suggestions when we have the necessary data
    if (formData.partyANationality && 
        formData.partyBNationality && 
        formData.subjectMatterLocation && 
        formData.enforcementLocations) {
      
      fetchSuggestedInstitutions();
    }
  }, [formData.partyANationality, formData.partyBNationality, 
      formData.subjectMatterLocation, formData.enforcementLocations]);

  const fetchSuggestedInstitutions = async () => {
    try {
      const response = await fetch('/api/institutions/suggest', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({
          partyANationality: formData.partyANationality,
          partyBNationality: formData.partyBNationality,
          subjectMatterLocation: formData.subjectMatterLocation,
          enforcementLocations: formData.enforcementLocations
        }),
      });
      
      const data = await response.json();
      setSuggestedInstitutions(data.institutions);
      
      // Auto-select the first suggestion
      if (data.institutions && data.institutions.length > 0) {
        setFormData(prev => ({
          ...prev,
          institution: data.institutions[0].id,
          seatOfArbitration: data.institutions[0].recommendedSeat
        }));
      }
    } catch (error) {
      console.error('Error fetching suggested institutions:', error);
    }
  };

  const handleInputChange = (e) => {
    const { name, value } = e.target;
    setFormData(prev => ({
      ...prev,
      [name]: value
    }));
  };

  const handleNextStep = () => {
    setCurrentStep(prev => Math.min(prev + 1, steps.length));
  };

  const handlePrevStep = () => {
    setCurrentStep(prev => Math.max(prev - 1, 1));
  };

  const handleSubmit = async () => {
    setLoading(true);
    
    try {
      const response = await fetch('/api/clauses/generate', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify(formData),
      });
      
      const data = await response.json();
      setGeneratedClauses(data.clauses);
      setCurrentStep(4); // Move to results step
    } catch (error) {
      console.error('Error generating clauses:', error);
    } finally {
      setLoading(false);
    }
  };
  
  const handleCopyClause = (clauseText) => {
    navigator.clipboard.writeText(clauseText);
    // Show a toast notification
  };
  
  const handleDownloadClause = async (clauseId, format) => {
    try {
      const response = await fetch(`/api/clauses/${clauseId}/download?format=${format}`, {
        method: 'GET',
        headers: {
          'Content-Type': 'application/json',
        },
      });
      
      const blob = await response.blob();
      const url = window.URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `clause-${clauseId}.${format}`;
      document.body.appendChild(a);
      a.click();
      a.remove();
    } catch (error) {
      console.error('Error downloading clause:', error);
    }
  };
  
  const handleSaveClause = async (clauseId) => {
    try {
      await fetch(`/api/clauses/${clauseId}/save`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
      });
      
      // Show success notification
    } catch (error) {
      console.error('Error saving clause:', error);
    }
  };

  // Render steps content based on current step
  const renderStepContent = () => {
    switch (currentStep) {
      case 1:
        return (
          <div className="space-y-6">
            <h2 className="text-2xl font-bold">Select Clause Type</h2>
            <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
              <div 
                className={`p-6 border rounded-lg cursor-pointer transition 
                  ${formData.clauseType === 'arbitration' ? 'border-blue-500 bg-blue-50' : 'border-gray-200 hover:border-blue-300'}`}
                onClick={() => setFormData(prev => ({ ...prev, clauseType: 'arbitration' }))}
              >
                <h3 className="font-semibold text-lg mb-2">Arbitration</h3>
                <p className="text-gray-600 text-sm">
                  Private dispute resolution with binding decision by neutral third party.
                </p>
              </div>
              
              <div 
                className={`p-6 border rounded-lg cursor-pointer transition 
                  ${formData.clauseType === 'mediation' ? 'border-blue-500 bg-blue-50' : 'border-gray-200 hover:border-blue-300'}`}
                onClick={() => setFormData(prev => ({ ...prev, clauseType: 'mediation' }))}
              >
                <h3 className="font-semibold text-lg mb-2">Mediation</h3>
                <p className="text-gray-600 text-sm">
                  Structured negotiation with neutral facilitator to reach voluntary agreement.
                </p>
              </div>
              
              <div 
                className={`p-6 border rounded-lg cursor-pointer transition 
                  ${formData.clauseType === 'multi-tiered' ? 'border-blue-500 bg-blue-50' : 'border-gray-200 hover:border-blue-300'}`}
                onClick={() => setFormData(prev => ({ ...prev, clauseType: 'multi-tiered' }))}
              >
                <h3 className="font-semibold text-lg mb-2">Multi-tiered</h3>
                <p className="text-gray-600 text-sm">
                  Sequential process, typically negotiation → mediation → arbitration.
                </p>
              </div>
            </div>
          </div>
        );
        
      case 2:
        return (
          <div className="space-y-6">
            <h2 className="text-2xl font-bold">Party Information</h2>
            <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <label className="block text-sm font-medium text-gray-700 mb-2">
                  Party A Nationality
                </label>
                <select
                  name="partyANationality"
                  value={formData.partyANationality}
                  onChange={handleInputChange}
                  className="w-full p-3 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500"
                  required
                >
                  <option value="">Select country</option>
                  <option value="US">United States</option>
                  <option value="UK">United Kingdom</option>
                  <option value="DE">Germany</option>
                  <option value="FR">France</option>
                  <option value="CN">China</option>
                  <option value="JP">Japan</option>
                  {/* Additional countries would be added here */}
                </select>
              </div>
              
              <div>
                <label className="block text-sm font-medium text-gray-700 mb-2">
                  Party B Nationality
                </label>
                <select
                  name="partyBNationality"
                  value={formData.partyBNationality}
                  onChange={handleInputChange}
                  className="w-full p-3 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500"
                  required
                >
                  <option value="">Select country</option>
                  <option value="US">United States</option>
                  <option value="UK">United Kingdom</option>
                  <option value="DE">Germany</option>
                  <option value="FR">France</option>
                  <option value="CN">China</option>
                  <option value="JP">Japan</option>
                  {/* Additional countries would be added here */}
                </select>
              </div>
            </div>
          </div>
        );
        
      case 3:
        return (
          <div className="space-y-6">
            <h2 className="text-2xl font-bold">Dispute Details</h2>
            
            <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <label className="block text-sm font-medium text-gray-700 mb-2">
                  Location of Subject Matter
                </label>
                <select
                  name="subjectMatterLocation"
                  value={formData.subjectMatterLocation}
                  onChange={handleInputChange}
                  className="w-full p-3 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500"
                  required
                >
                  <option value="">Select country</option>
                  <option value="US">United States</option>
                  <option value="UK">United Kingdom</option>
                  <option value="DE">Germany</option>
                  <option value="FR">France</option>
                  <option value="CN">China</option>
                  <option value="JP">Japan</option>
                  {/* Additional countries would be added here */}
                </select>
              </div>
              
              <div>
                <label className="block text-sm font-medium text-gray-700 mb-2">
                  Enforcement Location(s)
                </label>
                <select
                  name="enforcementLocations"
                  value={formData.enforcementLocations}
                  onChange={handleInputChange}
                  className="w-full p-3 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500"
                  required
                >
                  <option value="">Select country</option>
                  <option value="US">United States</option>
                  <option value="UK">United Kingdom</option>
                  <option value="DE">Germany</option>
                  <option value="FR">France</option>
                  <option value="CN">China</option>
                  <option value="JP">Japan</option>
                  {/* Additional countries would be added here */}
                </select>
              </div>
            </div>

            <div className="grid grid-cols-1 md:grid-cols-2 gap-6 mt-6">
              <div className="relative">
                <label className="block text-sm font-medium text-gray-700 mb-2">
                  Suggested Institution
                  <div className="inline-block ml-2 relative">
                    <Info 
                      className="h-4 w-4 text-gray-500 cursor-help inline"
