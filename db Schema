// User.js
const mongoose = require('mongoose');

const userSchema = new mongoose.Schema({
  email: {
    type: String,
    required: true,
    unique: true
  },
  password: {
    type: String,
    required: true
  },
  name: {
    type: String,
    required: true
  },
  savedClauses: [{
    type: mongoose.Schema.Types.ObjectId,
    ref: 'Clause'
  }],
  createdAt: {
    type: Date,
    default: Date.now
  }
});

module.exports = mongoose.model('User', userSchema);

// Clause.js
const mongoose = require('mongoose');

const clauseSchema = new mongoose.Schema({
  title: {
    type: String,
    required: true
  },
  text: {
    type: String,
    required: true
  },
  type: {
    type: String,
    enum: ['arbitration', 'mediation', 'multi-tiered'],
    required: true
  },
  institutionId: {
    type: mongoose.Schema.Types.ObjectId,
    ref: 'Institution',
    required: true
  },
  tags: [{
    type: String
  }],
  createdAt: {
    type: Date,
    default: Date.now
  }
});

module.exports = mongoose.model('Clause', clauseSchema);

// Institution.js
const mongoose = require('mongoose');

const institutionSchema = new mongoose.Schema({
  name: {
    type: String,
    required: true
  },
  country: {
    type: mongoose.Schema.Types.ObjectId,
    ref: 'Country',
    required: true
  },
  region: {
    type: String,
    enum: ['Africa', 'Asia', 'Europe', 'Middle East', 'North America', 'Oceania', 'South America'],
    required: true
  },
  officeLocations: [{
    type: String
  }],
  recommendedSeats: [{
    type: String
  }],
  reputationScore: {
    type: Number,
    default: 0
  },
  website: String,
  description: String
});

module.exports = mongoose.model('Institution', institutionSchema);

